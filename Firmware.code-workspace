{
	"folders": [
		{
			"name": "⚡ Firmware (ESP32)",
			"path": "firmware"
		},
		{
			"name": "🔌 Hardware",
			"path": "hardware"
		}
	],
	"settings": {
		"python.defaultInterpreterPath": "${workspaceFolder}/firmware/venv/bin/python",
		"python.analysis.extraPaths": [
			"${workspaceFolder}/firmware/src",
			"${workspaceFolder}/firmware/typings"
		],
		"files.exclude": {
			"**/.git": true,
			"**/.DS_Store": true,
			"**/__pycache__": true,
			"**/*.pyc": true
		}
	}
}